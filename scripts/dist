#!/bin/sh
# Build kard for every system it is handed out for, into dist/.
#
#   scripts/dist                  all systems
#   scripts/dist mac windows      only these; each word picks the systems
#                                 whose name contains it: mac (or darwin),
#                                 linux, windows, arm64, linux-amd64, ...
#
# Each file is a single program with the web interface inside; it needs no
# Go and nothing else on the target machine. The version comes from
# scripts/calculate_version.sh, from the Conventional Commits since the last
# version tag; kard version says it.
set -eu
cd "$(dirname "$0")/.."

targets="darwin/arm64 darwin/amd64 linux/amd64 linux/arm64 windows/amd64"
# The words that pick systems; mac and macos stand for darwin.
only=
for w in "$@"; do
	case $w in mac | macos) w=darwin ;; esac
	only="$only $w"
done

picked() {
	[ -z "$only" ] && return 0
	for w in $only; do
		case $1 in *"$w"*) return 0 ;; esac
	done
	return 1
}

version=v$(scripts/calculate_version.sh)
git diff --quiet HEAD 2>/dev/null || version=$version-dirty
rm -rf dist
mkdir -p dist

for t in $targets; do
	os=${t%/*}
	arch=${t#*/}
	picked "$os-$arch" || continue
	out=dist/kard-$version-$os-$arch
	[ "$os" = windows ] && out=$out.exe
	echo "build $out"
	CGO_ENABLED=0 GOOS=$os GOARCH=$arch go build -trimpath -ldflags "-s -w -X kardboard/internal/cli.version=$version" -o "$out" ./cmd/kard
done

# One file for both kinds of Mac, if lipo is there (it comes with Xcode).
if [ -f "dist/kard-$version-darwin-arm64" ] && [ -f "dist/kard-$version-darwin-amd64" ] && command -v lipo >/dev/null; then
	echo "build dist/kard-$version-macos"
	lipo -create -output "dist/kard-$version-macos" "dist/kard-$version-darwin-arm64" "dist/kard-$version-darwin-amd64"
fi

if ! ls dist/kard-* >/dev/null 2>&1; then
	echo "no system matches$only; there are: $targets" >&2
	exit 2
fi
(cd dist && shasum -a 256 kard-* > SHA256SUMS)
echo
ls -lh dist
